# Kopiraj u .env (lokalni razvoj) ili .env.prod (produkcija).
# INGEST_UID / INGEST_GID = `id -u` / `id -g` na hostu, da ingest piše u ./data bez --user root.

INGEST_UID=1000
INGEST_GID=1000

# Produkcija na lakehouse-edge (https://zg-atlas.lakehouse.hr)
POSTGRES_PASSWORD=atlas
DOMENA=zg-atlas.lakehouse.hr
JAVNI_URL=https://zg-atlas.lakehouse.hr
